# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Flight Data APIs (Optional - some are free without keys)
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# Application Settings
NODE_ENV=development
PORT=3000

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Get a free Mapbox access token from https://account.mapbox.com/access-tokens/
# 3. OpenSky Network credentials are optional but provide higher rate limits
# 4. Other flight APIs (Airplanes.live, adsb.fi) don't require authentication for basic usage
# 
# SECURITY NOTE:
# - NEVER commit .env files to GitHub!
# - For production deployment, use GitHub Secrets or environment variables
# - The .env file is already in .gitignore to prevent accidental commits

