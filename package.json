{
  "name": "mapbox-plane-tracker",
  "version": "1.0.0",
  "description": "3D Flight Route Simulator with Mapbox GL JS and real-time flight data",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "webpack serve --mode development",
    "dev:server": "cd server && npm run dev",
    "build": "webpack --mode production",
    "build:server": "cd server && npm install",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "mapbox-gl": "^2.15.0"
  },
  "devDependencies": {
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "file-loader": "^6.2.0",
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "flight-tracking",
    "mapbox",
    "3d-visualization",
    "real-time",
    "aviation",
    "ads-b"
  ],
  "author": "Flight Tracker Team",
  "license": "MIT"
}

